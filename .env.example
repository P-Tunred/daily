# Anthropic API key — read ONLY by the local server (electron/server.cjs and the
# Vite dev middleware). It is NOT VITE_-prefixed, so it never lands in the browser
# bundle. The renderer talks to /api/anthropic instead.
ANTHROPIC_API_KEY=sk-ant-...

# Set to 0 to hard-disable the Jarvis AI features in the UI. Default: enabled.
VITE_AI_ENABLED=1

# Your private Google Calendar iCal URL (read server-side only — also not VITE-
# inlined into anything the browser can read beyond the calendar JSON it returns).
VITE_GCAL_ICAL_URL=

# Optional: Twelve Data API key for reliable stock quotes (free, 800 calls/day)
# Get one at https://twelvedata.com (no credit card needed)
# Without this key, the app falls back to Yahoo Finance + Stooq
VITE_TWELVEDATA_KEY=

# ── Auth (password-protect the dashboard) ──────────────────────────────────
# Set both to enable password protection. Browser remembers login for 30 days.
# If AUTH_PASS is empty/missing, the dashboard is open (no login required).
AUTH_USER=paul
AUTH_PASS=
