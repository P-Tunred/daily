# Vorlage für /etc/daily/env auf der VM.
# Anlegen:  sudo mkdir -p /etc/daily && sudo nano /etc/daily/env
# Rechte:   sudo chmod 600 /etc/daily/env && sudo chown root:daily /etc/daily/env
#
# Diese Datei kommt NIE in git.

# ── Pflicht ──────────────────────────────────────────────────────────────────
# Ohne AUTH_PASS weigert sich der Server, auf mehr als 127.0.0.1 zu hören.
AUTH_USER=paul
AUTH_PASS=

# Wo der Server lauscht. Erst setzen, wenn AUTH_PASS steht.
#   127.0.0.1  nur über SSH-Tunnel erreichbar  (Empfehlung für den ersten Test)
#   0.0.0.0    von außen erreichbar            (nur mit Firewall oder Tailscale)
DAILY_HOST=127.0.0.1
PORT=4861

# ── Hermes-Schnittstelle ─────────────────────────────────────────────────────
# Eigenes Token für /api/hermes/* — bewusst getrennt vom Benutzerpasswort:
# so lässt sich das eine ändern, ohne das andere zu killen.
# Erzeugen mit:  openssl rand -hex 32
# Leer = Schnittstelle komplett aus (jede Anfrage bekommt 403).
HERMES_TOKEN=

# ── Mit Hermes sprechen ──────────────────────────────────────────────────────
# Hermes' API-Server im Gateway. Derselbe Wert wie API_SERVER_KEY in
# /root/.hermes/.env (dort zusammen mit API_SERVER_ENABLED=true).
# Leer = der Mikrofon-Knopf ist ausgegraut.
HERMES_API_KEY=
#HERMES_API_URL=http://127.0.0.1:8642
# Spracherkennung: faster-whisper aus Hermes' Python. "small" versteht besser,
# braucht auf zwei Kernen aber etwa dreimal so lange wie "base".
#DAILY_WHISPER_MODELL=base

# ── Schlüssel ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ZAI_API_KEY=
VITE_GCAL_ICAL_URL=
VITE_TWELVEDATA_KEY=
# Widget (Scriptable): öffnet nur GET /api/widget. Erzeugen: openssl rand -hex 24
DAILY_WIDGET_TOKEN=

# ── Datenquellen auf der VM ──────────────────────────────────────────────────
# Ausgaben der Hermes-Skripte, direkt statt über den Umweg Google Drive.
CALENDAR_JSON_PATH=
MAIL_REPORT_PATH=
SECOND_BRAIN_PATH=

# Der Verbrauchs-Tab liest auf dem Mac den Schlüsselbund — auf Linux geht das
# nicht. Die Claude-Zahlen fehlen dort also; die GLM-Zahlen kommen weiter.
USAGE_STATS=glm-only
